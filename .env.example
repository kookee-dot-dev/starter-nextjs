# Required. A standard API key: your Kookee project → API keys → Create Key.
KOOKEE_API_KEY=

# The site's public address, used in canonical URLs, the sitemap and feeds.
# On Vercel it defaults to the production domain; locally to http://localhost:3000.
SITE_URL=

# How long a page is served before it is rebuilt in the background, in seconds (default 6 hours).
KOOKEE_REVALIDATE_SECONDS=21600

# Set to false to hide the roadmap page and its link in the header.
KOOKEE_ROADMAP=true

# Set to true to show your Kookee status page at /status, with a link in the header.
KOOKEE_STATUS=false

# Optional. The signing secret of a Kookee webhook endpoint (whsec_…). Turns on
# /api/kookee-webhook, which refreshes pages as soon as you publish.
KOOKEE_WEBHOOK_SECRET=
